PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/aptitude_platform
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# NVIDIA NIM hosted API.
AI_PROVIDER=nvidia
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=minimaxai/minimax-m2.7

# Set true only for models/endpoints that support OpenAI response_format json_object.
AI_USE_RESPONSE_FORMAT=false
AI_DEFAULT_GENERATION_MODE=fast

# For local development when no external AI key is available.
# This enables a deterministic generator to keep assessment creation working.

# Smaller batches return faster and are easier for the model to keep as valid JSON.
AI_BATCH_SIZE=5
AI_BATCH_CONCURRENCY=2
AI_TIMEOUT_MS=120000
AI_FILE_CONTEXT_CHARS=5000
