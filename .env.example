PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cynex
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
ADMIN_EMAILS=professor@example.com,hod@example.com

# Optional SMTP settings for real password reset emails.
# If these are not set, the reset link is printed in the backend console during development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
EMAIL_FROM="CSE ICB Portal <your-email@example.com>"
